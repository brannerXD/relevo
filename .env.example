# ── Supabase ───────────────────────────────────────────────────────────────
# Estas dos son claves PUBLICABLES: van al navegador y es seguro compartirlas.
# Lo que protege los datos son las políticas RLS, no el secreto de la clave.
NEXT_PUBLIC_SUPABASE_URL=https://dcxiyhmotkhufvexrxyn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ilzKpG8K7BzogyUEDa79ww_bnDDelXC

# ── Motor de IA ────────────────────────────────────────────────────────────
# Con cualquiera de las dos funciona. Con las dos puestas usa Claude.

# Claude — lee mejor la letra manuscrita. Requiere saldo.
# https://console.anthropic.com
ANTHROPIC_API_KEY=

# Gemini — tiene capa gratuita con visión.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - RESPALDO. Capa gratuita sin tarjeta, muy rapida, pero lee la letra
# manuscrita peor que los otros dos. Va de ultimo en la cadena a proposito:
# que conteste el es mejor que un error, pero peor que Gemini o Claude.
# https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: si el nombre del modelo de Groq caduca (ya nos paso con Gemini),
# se cambia aqui sin tocar codigo.
GROQ_MODELO=

# Opcional: "claude", "gemini" o "groq" para forzar UNO y apagar la cadena.
# Asi se comparan calidad y costo sobre las mismas fotos.
RELEVO_PROVEEDOR=

# Ponga 1 cuando el proveedor de Google quede configurado en Supabase.
# Mientras esté vacío, el botón "Continuar con Google" no se muestra.
NEXT_PUBLIC_GOOGLE_LISTO=
